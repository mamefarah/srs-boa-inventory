# This file documents variable names only. Never commit real secrets.
# Copy to .env.local (already gitignored) and fill in your local Supabase project's
# values. Next.js reads .env.local from this directory (frontend/), not the repo root.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only variables, when/if introduced, must be stored in the deployment
# secret manager and must never use NEXT_PUBLIC_ prefixes.
