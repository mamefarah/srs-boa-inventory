# BoA-IMS LOCAL DEVELOPMENT API configuration only.
# Copy to .env.development.local and replace placeholders. The local file is gitignored.
# Never place postgres/migration-owner credentials in this file.

NODE_ENV=development
PORT=3000
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_DB_NAME=boa_ims_dev
SQL_USER=boa_ims_dev_app
SQL_PASSWORD=REPLACE_WITH_LOCAL_APP_ROLE_PASSWORD
SQL_SSL=disable
SQL_POOL_MAX=10
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=0
SERVE_WEB=false
LOG_LEVEL=debug
