# BoA-IMS environment variables — NAMES ONLY. Never commit real values.
# Production values live in the deployment secret manager.

# ---- API server (server/index.ts) ----
NODE_ENV=                 # development | production   (test is used only by the test runner)
PORT=
SQL_HOST=                 # host name, or a unix-socket directory such as /cloudsql/<instance>
SQL_PORT=
SQL_DB_NAME=
SQL_USER=                 # login role that is a member of boa_ims_app (least privilege; never the owner)
SQL_PASSWORD=
SQL_SSL=                  # disable | require   (production over TCP must be require)
SQL_POOL_MAX=
FIREBASE_PROJECT_ID=      # used only to verify Firebase ID tokens; no service-account key is needed
CORS_ALLOWED_ORIGINS=     # comma-separated EXACT origins; leave empty when the API serves the web app same-origin
TRUST_PROXY_HOPS=
SERVE_WEB=                # true to serve frontend/dist from the API
LOG_LEVEL=                # debug | info | warn | error | silent

# ---- Migrations / bootstrap (scripts/migrate.ts, scripts/bootstrap-admin.ts) ----
MIGRATION_SQL_USER=       # schema owner; needs CREATEROLE once to create boa_ims_app
MIGRATION_SQL_PASSWORD=
CONFIRM_PRODUCTION_MIGRATION=   # must equal SQL_DB_NAME to migrate production (human gate)
CONFIRM_PRODUCTION_BOOTSTRAP=   # must equal SQL_DB_NAME to bootstrap an admin in production
BOOTSTRAP_FIREBASE_UID=
BOOTSTRAP_REASON=

# ---- Web client build (public Firebase web identifiers; environment-specific) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---- Tests only (npm test). Destructive reset is refused unless all guards pass. ----
BOA_TEST_AUTH=            # enabled   (only valid with NODE_ENV=test)
ALLOW_TEST_DATABASE_RESET=  # true
TEST_SQL_HOST=            # must be local unless ALLOW_REMOTE_TEST_DATABASE=true
TEST_SQL_PORT=
TEST_SQL_DB_NAME=         # must contain a "test" name segment, e.g. boa_ims_test
TEST_SQL_MAINTENANCE_DB=
TEST_SQL_ADMIN_USER=
TEST_SQL_ADMIN_PASSWORD=
TEST_SQL_APP_USER=        # must contain a "test" segment and differ from the admin user
TEST_SQL_APP_PASSWORD=
ALLOW_REMOTE_TEST_DATABASE=
